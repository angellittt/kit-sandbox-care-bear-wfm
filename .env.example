# Every environment variable the apps read, with a safe example value.
# Copy this file to .env (git ignores it) and change what you need:
#
#   cp .env.example .env
#
# Nothing here is required: every variable has a default, so the stack runs
# without a .env file. Never put a real secret in this file. When you add a
# variable, list it here and add a safe fixture value to .env.test.

# --- web (apps/web) ---------------------------------------------------------

# Base URL the web app sends API requests to (src/lib/axios.ts). Leave it
# empty for relative requests (same origin as the web app).
VITE_API_BASE_URL=http://localhost:8000/api

# --- api (apps/api) ---------------------------------------------------------

# Port the API listens on. Default: 8000. docker-compose-dev.yml publishes
# 8000, so change both together.
PORT=8000

# Address the API binds to. Default: 0.0.0.0 (all interfaces).
HOST=0.0.0.0

# development | test | staging | production. Default: development. Also sets
# the log level (debug in development, silent in test, info otherwise).
# Left commented out: test runners set it themselves, and a value here would
# override them.
# NODE_ENV=development

# --- e2e (playwright.config.ts, e2e/) ---------------------------------------
# Playwright doesn't read .env. Export these in your shell to point a local
# Playwright run somewhere else. docker-compose-e2e.yml sets them for you.

# URL of the web app under test. Default: http://localhost:5173
# BASE_URL=http://localhost:5173

# URL of the API the e2e helpers call. Default: http://localhost:8000
# API_URL=http://localhost:8000
